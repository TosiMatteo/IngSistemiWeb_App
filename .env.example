# Copia questo file in ".env" e modifica i valori se necessario:
#   cp .env.example .env
# Tutte le variabili sono opzionali: senza .env vengono usati i default di docker-compose.yml.

# Porte esposte sull'host
APP_PORT=8080
MAILPIT_UI_PORT=8025

# Database MySQL
DB_NAME=Web_app
DB_USERNAME=aule
DB_PASSWORD=aule_password
DB_ROOT_PASSWORD=root_password

# Crea utenti e aule dimostrativi al primo avvio (solo se il database e' vuoto)
SEED_DEMO_DATA=true

# Email: di default i messaggi vengono catturati da Mailpit (http://localhost:8025).
# Per inviare email reali, ad esempio con Gmail (serve una "password per le app"):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tuo.indirizzo@gmail.com
# MAIL_PASSWORD=la-tua-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=tuo.indirizzo@gmail.com
